# CampusLuma Environment Configuration Template
# Backend environment template. Store real production values in the backend
# provider's secret manager; never copy them into this file or the frontend.

# --- JWT Session Security ---
# Interactive sign-in mode: local (default, development) or firebase (verified email)
CAMPUS_AUTH_MODE=local
# Replace with a generated random secret of at least 32 bytes in the backend secret manager.
CAMPUS_JWT_SECRET=replace-with-a-random-32-byte-secret-key-for-jwt-signing
# Expiration lifetime of user session access tokens in minutes (default: 480 = 8 hours)
CAMPUS_JWT_EXPIRE_MINUTES=480

# --- User Account Bootstrap (Local Development) ---
# JSON array of initial accounts with roles: admin, staff, analyst, viewer.
# Passwords will be salted and hashed on initialization via PBKDF2-HMAC-SHA256 (100k iterations).
# Local-only example; do not configure bootstrap users for Firebase production.
# CAMPUS_BOOTSTRAP_USERS=[{"email":"admin@example.invalid","name":"Campus Administrator","password":"replace-with-a-unique-password","role":"admin"}]

# --- Backward-Compatible API Tokens ---
# Retained for automated scripts, CLI tools, and Streamlit fallback compatibility
CAMPUS_API_KEYS={}
# CAMPUS_API_TOKEN=replace-with-a-unique-api-token

# --- Database & Service Configuration ---
CAMPUS_DB_PATH=data/campus.db
# Guest-only SQLite sandbox; never point this at the operational database.
CAMPUS_DEMO_DB_PATH=data/campus_demo.db
CAMPUS_API_URL=http://127.0.0.1:8000
# Comma-separated exact browser origins. Add the deployed Cloudflare Pages origin.
CAMPUS_CORS_ORIGINS=http://localhost:5173,https://your-project.pages.dev

# --- Firebase Authentication (only when CAMPUS_AUTH_MODE=firebase) ---
# Firebase project ID used to verify ID tokens on the backend.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to a server-only Firebase service account JSON file, stored outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\firebase-service-account.json
# Frontend settings are public Firebase web-app configuration, not service-account credentials.
# Put these in frontend/.env.local (Vite exposes VITE_ variables to the browser).
# VITE_AUTH_MODE=firebase
# VITE_API_BASE_URL=https://api.example.com
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_API_KEY=your-firebase-web-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
